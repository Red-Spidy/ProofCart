# =============================================================================
# ProofCart backend configuration template
# Copy to backend/.env and fill in real values. Never commit the filled-in file.
# In production these are set as environment variables on the host (Render).
# Every value here is server-side only — none of it may reach browser code.
# =============================================================================

# --- AI: intent extraction (Groq) ---
# Optional. If unset or unreachable, the deterministic FallbackIntentParser takes over
# and the app keeps working — see GroqIntentExtractor.
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Razorpay (Test Mode only) ---
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# --- MCP agent token security ---
# Pepper is mixed into the SHA-256 of every agent token before storage.
MCP_TOKEN_PEPPER=your-secure-random-pepper-string
# SHA-256 hex of "<pepper>:<token>" for the static service token.
# Leave blank ONLY for local dev — the server logs a loud warning and the static-token
# path is unsecured. Always set this in a deployed environment.
MCP_VALID_TOKEN_HASH=

# --- Database: Supabase PostgreSQL ---
# Unset locally falls back to an in-memory H2 database, which is enough to boot and test.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.your-project.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password
# 'validate' in production (schema comes from supabase/migrations/), 'update' locally.
JPA_DDL_AUTO=update

# --- Supabase Auth (JWT verification) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# --- Cache: Redis (optional) ---
# Redis is an optimisation only. If it's unreachable the app reads Postgres directly and
# checkout is unaffected — CatalogCacheService treats a down cache as non-fatal.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
# Managed Redis providers usually require TLS; set true when using one.
REDIS_SSL=false

# --- Web ---
# Comma-separated. Local and deployed origins can coexist.
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Injected automatically by Render and most PaaS hosts; defaults to 8080 locally.
# PORT=8080
